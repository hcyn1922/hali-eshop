# Hali e-shop - environment settings
# Local: copy to .env.   Vercel: Project → Settings → Environment Variables.

# --- Supabase (optional locally, required for a live Vercel site) -------------
# Project Settings → API (or "Connect"). The URL and the publishable/anon key are public.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# SERVER ONLY - never put VITE_ in front of it. Stores the shop database and product
# photos in Supabase. Without it data is kept in data/hali_shop_db.json (local only).
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# --- Owner account ------------------------------------------------------------
# The primary owner: always active with full access.
HALI_OWNER_EMAIL="you@example.com"
# Optional first password for the owner (8+ characters). You can also sign in
# with a Supabase Auth account for the same email instead.
HALI_OWNER_PASSWORD=""

# --- One-off import -----------------------------------------------------------
# Set to "true" on the very first start to import data/seed.json (catalog and
# orders from the previous system). Leave unset for a brand-new empty shop.
HALI_IMPORT_SEED=""

# Local server port
PORT=3000
