# Hali e-shop - environment settings
# Local: copy to .env.   Vercel: Project → Settings → Environment Variables.

# --- Supabase (optional locally, required for a live Vercel site) -------------
# Project Settings → API (or "Connect"). The URL and the publishable/anon key are public.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# SERVER ONLY - never put VITE_ in front of it. Stores the shop database and product
# photos in Supabase. Without it data is kept in data/hali_shop_db.json (local only).
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# --- Owner account ------------------------------------------------------------
# The primary owner: always active with full access.
HALI_OWNER_EMAIL="you@example.com"
# Optional first password for the owner (8+ characters). You can also sign in
# with a Supabase Auth account for the same email instead.
HALI_OWNER_PASSWORD=""

# --- Owner email notifications (optional) -----------------------------------
# Emails the owner about new orders, delivered orders and staff access requests.
# Create a free API key at https://resend.com (API Keys → Create API key).
RESEND_API_KEY=""
# Who receives the emails (defaults to HALI_OWNER_EMAIL).
NOTIFY_EMAIL=""
# Sender. Leave empty to use Resend's test sender (onboarding@resend.dev), which only
# delivers to the email you signed up to Resend with. After verifying your own domain
# in Resend, set e.g. "Hali e-shop <orders@hali.mv>" (also needed for staff Order emails).
MAIL_FROM=""

# --- AI studio product photos (optional) --------------------------------------
# Turns a snapshot of a product into studio photos (Products → edit → Photos →
# "Make AI studio photos"). Create a key at https://platform.openai.com/api-keys.
# SERVER ONLY - never put VITE_ in front of it.
OPENAI_API_KEY=""
# Image model and quality. gpt-image-2.5-flare is faster and cheaper; sunburst is more precise.
OPENAI_IMAGE_MODEL="gpt-image-2.5-sunburst"
OPENAI_IMAGE_QUALITY="high"
# Output size, 4:5 portrait (width and height must be divisible by 16).
OPENAI_IMAGE_SIZE="1024x1280"
# Model that inspects the photo and reads the label text before generating.
OPENAI_VISION_MODEL="gpt-6.1-sol"
# AI photos each staff member may make per day (cost control).
AI_PHOTO_DAILY_LIMIT="12"

# --- One-off import -----------------------------------------------------------
# Set to "true" on the very first start to import data/seed.json (catalog and
# orders from the previous system). Leave unset for a brand-new empty shop.
HALI_IMPORT_SEED=""

# Local server port
PORT=3000
